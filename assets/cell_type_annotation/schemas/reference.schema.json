{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iscdc.example/schemas/cell-type-reference-1.0.json",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "reference_id", "species", "tissue", "version", "files"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "reference_id": {"type": "string", "minLength": 1},
    "species": {"type": "string", "minLength": 1},
    "tissue": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "size", "sha256"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
          "size": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
